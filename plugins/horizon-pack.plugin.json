{
  "kind": "stockbot.plugin.v1",
  "schemaVersion": 1,
  "id": "horizon-pack",
  "name": "Horizon pack",
  "version": "1.0.0",
  "author": "Stockbot",
  "license": "MIT",
  "description": "Three methods across four holding-period horizons, each paired with turnover-matched controls. Every variant reads the same 1day bars; the horizon is the target holding period, because the engine has no yearly interval and resampling would change the data as well as the horizon.",
  "requires": {
    "capabilities": [
      "backtest"
    ],
    "sources": [],
    "secrets": [],
    "promptTemplates": [],
    "aiCli": false,
    "notes": "Requires core-controls for the passive buy-and-hold benchmark. Yearly variants need a multi-year window: on 400 bars they take 0-3 trades, on 1500 they take 6-11."
  },
  "methods": [
    {
      "id": "daily-ema",
      "name": "EMA Momentum — Daily",
      "role": "strategy",
      "horizon": "daily",
      "description": "EMA Momentum scaled to a ~2-bar holding period on daily bars.",
      "params": {
        "fast": 3,
        "slow": 8,
        "stopLossPercent": 3
      },
      "method": {
        "kind": "rules.v1",
        "warmup": {
          "param": "slow"
        },
        "indicators": {
          "fast": {
            "fn": "ema",
            "period": {
              "param": "fast"
            }
          },
          "slow": {
            "fn": "ema",
            "period": {
              "param": "slow"
            }
          }
        },
        "entry": [
          {
            "when": {
              "or": [
                {
                  "crossesAbove": [
                    "fast",
                    "slow"
                  ]
                },
                {
                  "and": [
                    {
                      "eq": [
                        {
                          "var": "index"
                        },
                        {
                          "param": "slow"
                        }
                      ]
                    },
                    {
                      "gt": [
                        "fast",
                        "slow"
                      ]
                    }
                  ]
                }
              ]
            },
            "reason": "Fast EMA crossed above slow EMA"
          }
        ],
        "exit": [
          {
            "when": {
              "lte": [
                {
                  "bar": "close"
                },
                {
                  "mul": [
                    {
                      "position": "entryPrice"
                    },
                    {
                      "sub": [
                        1,
                        {
                          "div": [
                            {
                              "param": "stopLossPercent"
                            },
                            100
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "reason": "Protective stop"
          },
          {
            "when": {
              "crossesBelow": [
                "fast",
                "slow"
              ]
            },
            "reason": "Fast EMA crossed below slow EMA"
          }
        ]
      }
    },
    {
      "id": "daily-rsi",
      "name": "RSI Mean Reversion — Daily",
      "role": "strategy",
      "horizon": "daily",
      "description": "RSI Mean Reversion scaled to a ~2-bar holding period on daily bars.",
      "params": {
        "period": 3,
        "oversold": 25,
        "exitLevel": 55,
        "maxHoldBars": 3
      },
      "method": {
        "kind": "rules.v1",
        "warmup": {
          "add": [
            {
              "param": "period"
            },
            1
          ]
        },
        "indicators": {
          "rsi": {
            "fn": "rsi",
            "period": {
              "param": "period"
            }
          }
        },
        "entry": [
          {
            "when": {
              "and": [
                {
                  "lt": [
                    {
                      "series": {
                        "name": "rsi",
                        "offset": 1
                      }
                    },
                    {
                      "param": "oversold"
                    }
                  ]
                },
                {
                  "gte": [
                    "rsi",
                    {
                      "param": "oversold"
                    }
                  ]
                }
              ]
            },
            "reason": "RSI recovered up through the oversold threshold"
          }
        ],
        "exit": [
          {
            "when": {
              "gte": [
                "rsi",
                {
                  "param": "exitLevel"
                }
              ]
            },
            "reason": "RSI reverted to the exit level"
          },
          {
            "when": {
              "gte": [
                {
                  "var": "barsSinceEntry"
                },
                {
                  "param": "maxHoldBars"
                }
              ]
            },
            "reason": "Time stop"
          }
        ]
      }
    },
    {
      "id": "daily-donchian",
      "name": "Donchian Breakout — Daily",
      "role": "strategy",
      "horizon": "daily",
      "description": "Donchian Breakout scaled to a ~2-bar holding period on daily bars.",
      "params": {
        "entryPeriod": 5,
        "exitPeriod": 3,
        "atrPeriod": 7,
        "atrStopMultiple": 1.5
      },
      "method": {
        "kind": "rules.v1",
        "warmup": {
          "param": "entryPeriod"
        },
        "indicators": {
          "channelHigh": {
            "fn": "highestHigh",
            "period": {
              "param": "entryPeriod"
            }
          },
          "channelLow": {
            "fn": "lowestLow",
            "period": {
              "param": "exitPeriod"
            }
          },
          "atr": {
            "fn": "atr",
            "period": {
              "param": "atrPeriod"
            }
          }
        },
        "entry": [
          {
            "when": {
              "gt": [
                {
                  "bar": "close"
                },
                "channelHigh"
              ]
            },
            "reason": "Close cleared the prior channel high"
          }
        ],
        "exit": [
          {
            "when": {
              "lt": [
                {
                  "bar": "close"
                },
                "channelLow"
              ]
            },
            "reason": "Close broke the prior channel low"
          },
          {
            "when": {
              "lt": [
                {
                  "bar": "close"
                },
                {
                  "sub": [
                    {
                      "position": "entryPrice"
                    },
                    {
                      "mul": [
                        "atr",
                        {
                          "param": "atrStopMultiple"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "reason": "ATR stop"
          }
        ]
      }
    },
