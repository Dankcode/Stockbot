    {
      "id": "horizon-fixed",
      "name": "Control — Horizon Fixed Interval",
      "role": "control",
      "horizon": "none",
      "controlFor": "any horizon-pack strategy sharing the same horizon param",
      "description": "Exposure-matched horizon control: buys on a cadence derived from the horizon band and dutyCycle, holds the band span, and ignores price.",
      "params": {
        "horizon": "weekly",
        "dutyCycle": 0.4,
        "warmupBars": 1
      },
      "method": {
        "kind": "rules.v1",
        "warmup": {
          "const": "warmup"
        },
        "derived": {
          "warmup": {
            "max": [
              1,
              {
                "trunc": {
                  "param": "warmupBars"
                }
              }
            ]
          },
          "hold": {
            "lookup": {
              "map": {
                "daily": 2,
                "weekly": 5,
                "monthly": 21,
                "yearly": 252
              },
              "key": {
                "param": "horizon"
              },
              "default": 5
