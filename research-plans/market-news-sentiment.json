{
  "schemaVersion": 1,
  "id": "market-news-sentiment",
  "name": "Retail market news and sentiment",
  "description": "Reads registered public market-news and quote pages for the symbol and produces a bounded point-in-time sentiment summary. Every source in this plan must be authorized by the operator before its origin is registered.",
  "symbols": [
    "*"
  ],
  "steps": [
    {
      "id": "nasdaq-headlines",
      "kind": "scrape",
      "adapter": "web.page.v1",
      "request": {
        "sourceId": "nasdaq-news",
        "pathTemplate": "/market-activity/stocks/{{symbol}}/news-headlines",
        "format": "html"
      },
      "limits": {
        "timeoutMs": 15000,
        "maxBytes": 1000000
      }
    },
    {
      "id": "nasdaq-press-releases",
      "kind": "scrape",
      "adapter": "web.page.v1",
      "request": {
        "sourceId": "nasdaq-news",
        "pathTemplate": "/market-activity/stocks/{{symbol}}/press-releases",
        "format": "html"
      },
      "limits": {
        "timeoutMs": 15000,
        "maxBytes": 1000000
      }
    },
    {
      "id": "finviz-quote",
      "kind": "scrape",
      "adapter": "web.page.v1",
      "request": {
        "sourceId": "finviz",
        "pathTemplate": "/quote.ashx",
        "query": {
          "t": "{{symbol}}"
        },
        "format": "html"
      },
      "limits": {
        "timeoutMs": 15000,
        "maxBytes": 1000000
      }
    },
    {
      "id": "sentiment-summary",
      "kind": "summarize",
      "adapter": "ai.cli.summary.v1",
      "dependsOn": [
        "nasdaq-headlines",
        "nasdaq-press-releases",
        "finviz-quote"
      ],
      "promptTemplate": "market-summary.v1",
      "responseSchema": "market-summary.v1",
      "limits": {
        "timeoutMs": 90000,
        "maxInputBytes": 2000000
      }
    }
  ],
  "outputStep": "sentiment-summary",
  "delivery": {
    "strategy": true,
    "required": false,
    "maxAgeMs": 21600000
  }
}
