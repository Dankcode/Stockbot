# Copy this file outside the repository (the initializer defaults to
# ~/.config/stockbot/stockbot.env) and keep it readable only by your user.
DATABASE_URL='postgresql://stockbot:replace-me@127.0.0.1:5432/stockbot'
STOCKBOT_DATABASE_LOCATION=local

# Generate independent values of at least 32 characters. The initializer does
# this without displaying them.
STOCKBOT_API_TOKEN='replace-with-a-random-secret'
STOCKBOT_SETTINGS_KEY='replace-with-a-different-random-secret'

PORT=4000
HOST=127.0.0.1
STOCKBOT_MODE=local-paper
ENGINE_WORKERS=2
ENGINE_TIMEOUT_MS=10000
QUOTE_FRESHNESS_MS=5000

# Add one or more server-side market-data providers as needed.
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Optional AI research. Register exact credential-free HTTPS origins by source
# id. Imported plans can select these ids but cannot choose arbitrary origins.
RESEARCH_WEB_SOURCES_JSON='{}'

# Configure only an operator-reviewed JSON-in/JSON-out executable by absolute path. The imported
# plan never controls the command, argv, model label, output budget, or env.
AI_CLI_COMMAND=
AI_CLI_ARGS_JSON='[]'
AI_CLI_MODEL=operator-configured-cli
AI_CLI_TIMEOUT_MS=60000
AI_CLI_MAX_INPUT_BYTES=500000
AI_CLI_MAX_OUTPUT_BYTES=100000
AI_CLI_ENV_ALLOWLIST_JSON='[]'

# Provider credentials for the selected CLI remain server-side and are passed
# only when their variable names are in AI_CLI_ENV_ALLOWLIST_JSON.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
