# Copy this file outside the repository (the initializer defaults to
# ~/.config/stockbot/stockbot.env) and keep it readable only by your user.
DATABASE_URL='postgresql://stockbot:replace-me@127.0.0.1:5432/stockbot'
STOCKBOT_DATABASE_LOCATION=local

# Generate independent values of at least 32 characters. The initializer does
# this without displaying them.
STOCKBOT_API_TOKEN='replace-with-a-random-secret'
STOCKBOT_SETTINGS_KEY='replace-with-a-different-random-secret'

PORT=4000
HOST=127.0.0.1
STOCKBOT_MODE=local-paper
ENGINE_WORKERS=2
ENGINE_TIMEOUT_MS=10000
QUOTE_FRESHNESS_MS=5000

# Add one or more server-side market-data providers as needed.
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=
FINNHUB_API_KEY=
