PORT=4000
HOST=127.0.0.1
DATABASE_URL=file:./data/stockbot.db
# UI classification used by the protected database settings editor.
STOCKBOT_DATABASE_LOCATION=local
# Set to an absolute owner-only env path only when the server should allow the
# database settings screen to persist DATABASE_URL changes.
STOCKBOT_CONFIG_FILE=

# Server-side shared secret for all mutating API requests. Use at least 32 random
# characters. It becomes required if remote binding is explicitly enabled. Enter
# the same value in Settings > API mutation token for each browser session. Never
# copy it into a VITE_* variable because Vite values are embedded in the web build.
STOCKBOT_API_TOKEN=

# Required only when saving provider secrets through the Settings screen.
# Use at least 32 random characters and keep it outside version control.
STOCKBOT_SETTINGS_KEY=

ENGINE_WORKERS=2
ENGINE_TIMEOUT_MS=10000
QUOTE_CACHE_MS=4000
QUOTE_FRESHNESS_MS=5000
BAR_SETTLE_DELAY_MS=2000

# Optional. Without a configured provider, market values render unavailable;
# Stockbot never substitutes synthetic prices or bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ASSET_CACHE_TTL_MS=1800000
ALPACA_STOCK_FEED=iex

# Optional historical data fallbacks. Used if Alpaca historical bars are unavailable.
POLYGON_API_KEY=
FINNHUB_API_KEY=
# If you already have NEXT_PUBLIC_FINNHUB_API_KEY from another frontend project,
# copy the same value into FINNHUB_API_KEY for Stockbot's server-side calls.

# Optional. Used later for AI-assisted strategy research and summaries.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local runtime label. Live order routing is not implemented.
STOCKBOT_MODE=local-paper
