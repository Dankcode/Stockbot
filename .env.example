PORT=4000
HOST=127.0.0.1
DATABASE_URL=file:./data/stockbot.db
# UI classification used by the protected database settings editor.
STOCKBOT_DATABASE_LOCATION=local
# Set to an absolute owner-only env path only when the server should allow the
# database settings screen to persist DATABASE_URL changes.
STOCKBOT_CONFIG_FILE=

# Server-side shared secret for all mutating API requests. Use at least 32 random
# characters. It becomes required if remote binding is explicitly enabled. Enter
# the same value in Settings > API mutation token for each browser session. Never
# copy it into a VITE_* variable because Vite values are embedded in the web build.
STOCKBOT_API_TOKEN=

# Required only when saving provider secrets through the Settings screen.
# Use at least 32 random characters and keep it outside version control.
STOCKBOT_SETTINGS_KEY=

ENGINE_WORKERS=2
ENGINE_TIMEOUT_MS=10000
QUOTE_CACHE_MS=4000
QUOTE_FRESHNESS_MS=5000
BAR_SETTLE_DELAY_MS=2000

# Optional. Without a configured provider, market values render unavailable;
# Stockbot never substitutes synthetic prices or bars.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_ASSET_CACHE_TTL_MS=1800000
ALPACA_STOCK_FEED=iex

# Optional historical data fallbacks. Used if Alpaca historical bars are unavailable.
POLYGON_API_KEY=
FINNHUB_API_KEY=
# If you already have NEXT_PUBLIC_FINNHUB_API_KEY from another frontend project,
# copy the same value into FINNHUB_API_KEY for Stockbot's server-side calls.

# Optional AI research pipeline. Plans can reference only the code-owned adapters
# and source ids configured here; they cannot provide origins, commands, arguments,
# headers, credentials, or environment variables. Each web source value must be
# a credential-free HTTPS origin (an optional fixed base path is allowed).
#
# Registering an origin is the ONLY switch that enables a source. A plan step whose
# sourceId is absent here fails closed with RESEARCH_SOURCE_NOT_CONFIGURED, so you
# remove a source by deleting its entry below, not by editing the plans.
#
# You are responsible for each origin's terms of service, robots.txt policy,
# attribution requirements, and rate limits. Verify before enabling. See
# docs/RESEARCH_SOURCES.md for per-source status and known blockers (SAM.gov and
# FPDS are documented there as unreachable through web.page.v1).
#
# After changing this value, restart Stockbot and confirm each source resolves
# through the adapter's real guardrails:
#   npm run research:probe -- --symbol NVDA
#
# Government contracts and SEC filings - keyless public GET endpoints:
#   sec-edgar      https://www.sec.gov          EDGAR filing index by ticker (HTML)
#   sec-edgar-fts  https://efts.sec.gov         EDGAR full-text search (JSON)
#   dod-contracts  https://www.war.gov          daily DoD contract announcements (HTML)
#                                               NOTE: www.defense.gov 302s cross-host to
#                                               www.war.gov and the adapter blocks that,
#                                               so register war.gov directly.
#   usaspending    https://api.usaspending.gov  agency-level federal spending (JSON)
#                                               GET endpoints only; award search is POST.
#
# Retail market news - robots-permitted paths, but verify each site's terms and
# expect CDN bot protection. Omit these to disable the market-news-sentiment plan:
#   nasdaq-news    https://www.nasdaq.com
#   finviz         https://finviz.com
#
# Social sentiment - see docs/SENTIMENT_PACK.md. Twitter/X is NOT reachable: it
# requires paid API auth, and this adapter cannot send credentials or custom headers.
#   bluesky        https://public.api.bsky.app   public AppView searchPosts, no key
#   stocktwits     https://api.stocktwits.com    cashtag streams; access is tightening
#   reddit         https://www.reddit.com        search.json; blocks many bot UAs.
#                                                Register www.reddit.com - the bare
#                                                domain redirects cross-host and fails.
#
# Full catalogue, ready to paste (trim whatever you have not authorized):
# RESEARCH_WEB_SOURCES_JSON={"sec-edgar":"https://www.sec.gov","sec-edgar-fts":"https://efts.sec.gov","dod-contracts":"https://www.war.gov","usaspending":"https://api.usaspending.gov","nasdaq-news":"https://www.nasdaq.com","finviz":"https://finviz.com","bluesky":"https://public.api.bsky.app","stocktwits":"https://api.stocktwits.com","reddit":"https://www.reddit.com"}
RESEARCH_WEB_SOURCES_JSON={}

# AI_CLI_COMMAND names one operator-reviewed executable by absolute path. Stockbot invokes it
# directly with shell:false, writes the versioned request JSON to stdin, and
# accepts only market-summary.v1 JSON on stdout. Arguments and forwarded secret
# names are server-owned JSON arrays. Keep the allowlist empty unless needed.
AI_CLI_COMMAND=
AI_CLI_ARGS_JSON=[]
AI_CLI_MODEL=operator-configured-cli
AI_CLI_TIMEOUT_MS=60000
AI_CLI_MAX_INPUT_BYTES=500000
AI_CLI_MAX_OUTPUT_BYTES=100000
AI_CLI_ENV_ALLOWLIST_JSON=[]

# Example credentials for an operator-selected AI CLI. These are not forwarded
# unless their names are explicitly present in AI_CLI_ENV_ALLOWLIST_JSON.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local runtime label. Live order routing is not implemented.
STOCKBOT_MODE=local-paper
